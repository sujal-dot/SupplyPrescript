# ==============================================================================
# SupplyPrescript — Environment Configuration Template (.env.example)
# Phase 8 — Production Polish (Day 24)
# ==============================================================================

# Application Environment & Logging
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL Operational Database
DATABASE_URL=postgresql+psycopg2://supplyprescript:change_me_in_production@localhost:5432/supplyprescript
POSTGRES_DB=supplyprescript
POSTGRES_USER=supplyprescript
POSTGRES_PASSWORD=change_me_in_production

# Service Networking & Cross-Origin Resource Sharing (CORS)
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Authentication & RBAC Hardening (Day 24)
# Set AUTH_REQUIRED=true in production/staging to require Authorization: Bearer <token> on all endpoints
AUTH_ENABLED=true
AUTH_REQUIRED=false
AUTH_SECRET_KEY=change_this_to_a_cryptographically_secure_random_key_in_production
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ML Inference & Active Model Registry
ACTIVE_MODEL_VERSION=v1.0
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_HIGH=0.70

# Monitored Retraining & Performance Drift Safeguards (Day 23)
RETRAINING_MIN_FEEDBACK_THRESHOLD=10
RETRAINING_MIN_TRAIN_SAMPLES=50
RETRAINING_MIN_VAL_SAMPLES=15
RETRAINING_DEGRADATION_MAE_THRESHOLD_PCT=15.0
RETRAINING_DEGRADATION_MAE_ABSOLUTE_DAYS=0.25
RETRAINING_MIN_IMPROVEMENT_PCT=3.0
RETRAINING_MAX_SECONDARY_REGRESSION_PCT=10.0
RETRAINING_COOLDOWN_MINUTES=60
RETRAINING_MAX_CONCURRENT_JOBS=1
RETRAINING_AUTO_PROMOTION_ENABLED=false
RETRAINING_CANDIDATES_DIR=ml/artifacts/candidates
